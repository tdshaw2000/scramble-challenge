# SCRCH_SITE_ADDRESS is the public domain on the server (Caddy then gets and renews a
# Let's Encrypt certificate itself), or ":80" for plain HTTP in CI and local runs.
{$SCRCH_SITE_ADDRESS} {
	# Caddy passes WebSocket upgrades through without extra config.
	reverse_proxy scramble-web:5000
}
{$WCA_SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy wca-records-analyser:8000
}
{$TIMER_SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy timer-app-pr-tracker:8000
}
{$PUZZLE_SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy puzzle-trainer:8000
}
{$HUB_SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy tds-hub:8000
}
