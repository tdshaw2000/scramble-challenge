{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github__update_pull_request|mcp__github__create_pull_request|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/review_gate.py\" gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/review_gate.py\" record"
          }
        ]
      }
    ]
  }
}
